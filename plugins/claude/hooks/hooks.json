{
	"modules": ["./mod.js"],
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "out=$(\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" session-start --claude --pid \"$PPID\" --address \"$ANTHROPIC_BASE_URL\") || { code=$?; printf '%s\\n' \"$out\" >&2; exit $code; }; printf '%s' \"$out\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" session-start --claude --pid \"$PPID\" --address \"$ANTHROPIC_BASE_URL\" 1>&2 || exit 2",
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" prompt-submit --claude --address \"$ANTHROPIC_BASE_URL\"",
						"timeout": 10,
						"onFailure": "block"
					},
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" answer-check --address \"$ANTHROPIC_BASE_URL\"",
						"timeout": 10,
						"onFailure": "block"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" turn-end --address \"$ANTHROPIC_BASE_URL\"",
						"timeout": 10
					}
				]
			}
		],
		"SubagentStop": [
			{
				"matcher": "^phi-router:phi-sealed$",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" answer-check --address \"$ANTHROPIC_BASE_URL\"",
						"timeout": 60
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^SubagentHandback$",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" answer-check --address \"$ANTHROPIC_BASE_URL\"",
						"timeout": 60
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^Agent$",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" answer-check --address \"$ANTHROPIC_BASE_URL\"",
						"timeout": 10
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PLUGIN_ROOT}/bin/phi-router\" session-start --claude --pid \"$PPID\" --address \"$ANTHROPIC_BASE_URL\" 1>&2",
						"onFailure": "block"
					}
				]
			}
		]
	}
}
